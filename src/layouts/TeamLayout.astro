---
// Assets
import { Image } from "astro:assets";
// Fundations
import BaseLayout from "@/layouts/LayoutPulito.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

// RICEVIAMO SOLO IL FRONTMATTER
const { title, description, canonical, image, ogType, frontmatter } =
  Astro.props;
---

<BaseLayout
  title={frontmatter?.title}
  description={frontmatter?.description}
  canonical={frontmatter?.canonical}
  image={frontmatter?.ogImage}
  hideBigLogo={true}
  hideNavigation={false}
>
  <section>
    <Wrapper variant="standard" class="pt-2">
      <div class="max-w-xl mx-auto text-center text-base-900">
        <!--<Text
          tag="a"
          href="javascript:history.back()"
          variant="textXS"
          class="inline-flex items-center gap-1 hover: transition-colors"
        >
          &larr; Go back
        </Text> -->

        <Text
          tag="p"
          variant="textXL"
          class="font-light mt-4 font-serif uppercase leading-6 mt-12"
        >
          <span class="block opacity-50">
            {frontmatter.name}
          </span>

          <span class="block">{frontmatter.role}</span>
        </Text>
        <Image
          alt={frontmatter.image.alt}
          src={frontmatter.image.url}
          width={800}
          height={800}
          loading="lazy"
          decoding="async"
          class="object-cover w-full aspect-square mt-8 rounded-2xl"
        />
        <div class="mt-8 space-y-4">
          {
            frontmatter.bio.split("\n").map((paragraph) => (
              <Text
                tag="p"
                variant="textSM"
                class="text-base-900  leading-6 text-balance font-serif uppercase"
              >
                {paragraph}
              </Text>
            ))
          }
        </div>

        <div class="mt-10 space-y-4 text-center">
          <p class="text-sm text-neutral-500 font-serif">
            Vuoi conoscere meglio il mio percorso fotografico?
          </p>

          <a
            href="/biografia-fotografo/"
            class="text-sm text-base-900 underline underline-offset-4 hover:text-neutral-600"
          >
            Leggi la biografia completa di Elio Leonardo Carchidi →
          </a>

          <p class="mt-6 text-sm text-neutral-500 font-serif">
            Interviste e pubblicazioni dedicate al mio lavoro fotografico:
          </p>

          <a
            href="/pubblicazioni-e-rassegna-stampa/"
            class="text-sm text-base-900 underline underline-offset-4 hover:text-neutral-600"
          >
            Consulta la rassegna stampa →
          </a>
        </div>

        <div class="mt-8 flex justify-center">
          <a
            href="/atelier/sessioni-private/"
            class="inline-block rounded-md bg-gray-900 hover:bg-gray-800 text-white font-medium px-6 py-3 transition"
          >
            Prenota la tua sessione di ritratto
          </a>
        </div>
        <div class="mt-8 space-y-1">
          <p class="text-sm text-neutral-500">
            Lavoro in spazi selezionati per luce e concentrazione.
          </p>

          <a
            href="/dove-lavoro/"
            class="group inline-flex items-center gap-1 text-sm text-neutral-400 transition-colors hover:text-neutral-600"
          >
            Dove lavoro

            <span
              class="transition-transform duration-300 group-hover:translate-x-1"
            >
              →
            </span>
          </a>
        </div>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
