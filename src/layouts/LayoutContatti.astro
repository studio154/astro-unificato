---
// Fundations
import BigLogo from "@/components/assets/LogoAtelier.astro";
import "@/styles/global.css";
import BaseHead from "@/components/fundations/head/BaseHead.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import Footer from "@/components/global/Footer.astro";
import Navigation from "@/components/global/NavigazioneHamburgerStandard.astro";

const {
  title,
  description,
  canonical,
  image,
  ogType,
  hideBigLogo = true,
  hideNavigation = false,
  hideFooter = false,
} = Astro.props;
---

<html lang="it" class="scroll-smooth">
  <head>
    <BaseHead
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      ogType={ogType}
    />
  </head>
  <!-- w-full e overflow-x-hidden impediscono alla pagina di slittare o creare scroll laterali -->
  <body
    class="flex flex-col bg-gallery-8 min-h-svh w-full overflow-x-hidden antialiased"
  >
    {
      !hideBigLogo && (
        <Wrapper variant="standard" class="pt-8 mx-auto w-full">
          <BigLogo />
        </Wrapper>
      )
    }
    {!hideNavigation && <Navigation />}

    <!-- mx-auto e w-full assicurano che il contenuto principale rimanga geometricamente al centro -->
    <main class="grow w-full mx-auto flex flex-col items-center justify-start">
      <slot />
    </main>

    {!hideFooter && <Footer />}
  </body>
</html>
