---
// Assets

// Fundations
import Text from "@/components/fundations/elements/Text.astro";

// Content
const { title, url, thumbnail, category } = {
  url: "/galleria/immagini/" + Astro.props.post.slug,
  title: Astro.props.post.data.title,
  category: Astro.props.post.data.category,
  thumbnail: Astro.props.post.data.thumbnail.url,
};
---

<article class="relative">

  <div class="relative group rounded-2xl overflow-hidden cursor-pointer">

    <img
      src={thumbnail}
      alt={title}
      category={category}
      loading="lazy"
      class="w-full object-contain object-center transition-all duration-700 ease-out group-hover:scale-[1.015] group-hover:brightness-95"
    />

    <!-- Overlay -->
    <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition duration-700"></div>

    <!-- Testi sopra immagine -->
    <div class="absolute inset-0 flex items-center justify-center z-10">
      <div class="text-center opacity-0 group-hover:opacity-100 transition duration-500 px-6">

        <p class="text-white text-xs tracking-[0.3em] uppercase opacity-70">
          {category}
        </p>

        <h3 class="text-white text-2xl md:text-3xl font-light mt-2">
          {title}
        </h3>
<p class="mt-4 text-white text-xs tracking-[0.25em] uppercase">
  Apri galleria →
</p>
      </div>
    </div>

    <!-- Link -->
    <a
      href={url}
      aria-label={`Apri la galleria: ${title}`}
      class="absolute inset-0 z-20"
    />

  </div>

</article>