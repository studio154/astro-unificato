---
// Assets
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import SocialLinks from "@/components/fundations/icons/SocialLinks.astro";
---

<footer>
  <Wrapper variant="standard" class="pb-8 pt-20 lg:pt-20">
    <div class="mt-8 space-y-4 w-full">
      <Text
  tag="p"
  variant="textXL"
  class="max-w-xl mx-auto font-light !font-serif uppercase text-center leading-6 text-base-900"
>
  Since <time datetime="1976" class="font-serif">1976</time>
  <span class="block">fotografia di ritratto</span>
</Text>
      <Text
        tag="p"
        variant="textBase"
        class="max-w-xl mx-auto !font-serif uppercase text-balance text-center leading-tight text-base-900"
      >
        <span>Lo studio fotografico riceve</span><br />
        esclusivamente su appuntamento<br /><br />
        <a class="hover:text-base-900 text-gallery-5" href="/servizi">
          Servizi e collaborazioni
        </a>
      </Text>

      <div
        class="grid grid-cols-1 md:grid-cols-3 items-center text-center mt-8 uppercase text-base-900 font-medium"
      >
        <Text tag="p" variant="textM" class="md:text-left">
          <a
            href="/contatti"
            title="invia una richiesta"
            class="hover:opacity-80 transition-opacity"
          >
            RICHIEDI UN APPUNTAMENTO
          </a>
        </Text>

        <Text tag="p" variant="textM" class="site-title text-base">
          <a
            href="/blog"
            title="sito ufficiale home"
            class="hover:opacity-80 transition-opacity"
          >
            JOURNAL & NOTES
          </a>
        </Text>

        <Text tag="p" variant="textM" class="md:text-right">
          <a
            href="https://studio154.it/"
            title="studio fotografico studio154"
            target="_blank"
            class="hover:opacity-80 transition-opacity"
          >
            Studio154
          </a>
        </Text>
      </div>
      <!-- SOCIAL -->
      <SocialLinks />
      <!-- COPYRIGHT -->
      <p
        class="mt-10 text-xs md:text-sm text-base-900/60 italic tracking-wide text-center"
      >
        © Elio Carchidi — Tutti i diritti riservati. Uso non autorizzato
        vietato.
      </p>
    </div>
  </Wrapper>
</footer>
