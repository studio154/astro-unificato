---
const currentPath = Astro.url.pathname;

const menuLinks = [
  { href: "/portfolio/", label: "Portfolio" },
  { href: "/atelier/", label: "Atelier" },
  { href: "/chi-sono/", label: "Chi sono" },
  { href: "/contatti/", label: "Contatti" },
  {
    href: "/formazione-fotografica/",
    label: "Formazione",
  },
];

import Text from "@/components/fundations/elements/Text.astro";
---

<nav class="w-full border-b border-neutral-200/60 bg-[#f2f0e8]/90 backdrop-blur-md">
  <div class="flex items-center justify-between px-6 py-7 md:px-12 lg:px-20 xl:px-24">

    <!-- Logo -->
    <a href="/" class="flex flex-col leading-none">
  <span class="site-title text-[1.12rem] font-black uppercase tracking-[-0.04em] text-black">
    Elio Leonardo Carchidi
  </span>

  <span class="mt-1 text-[11px] leading-none tracking-[0.06em] text-neutral-500">
    Fotografo · Roma · dal 1980
  </span>
</a>

    <!-- Hamburger -->
    <button
      id="hamburgerBtn"
      class="flex h-10 w-10 items-center justify-center lg:hidden"
      aria-controls="mobileMenu"
      aria-expanded="false"
      type="button"
    >
      <span class="sr-only">Apri menu</span>

      <div class="flex flex-col gap-1">
        <span class="block h-0.5 w-5 bg-black"></span>
        <span class="block h-0.5 w-5 bg-black"></span>
        <span class="block h-0.5 w-5 bg-black"></span>
      </div>
    </button>

    <!-- Menu desktop -->
    <div class="hidden items-center gap-8 text-[0.82rem] uppercase tracking-[0.08em] lg:flex">

      {menuLinks.map((link) => (
        <Text
          tag="a"
          href={link.href}
          variant="textBase"
          class={`transition-colors ${
            currentPath === link.href
              ? "font-semibold text-black"
              : "text-neutral-600 hover:text-black"
          }`}
        >
          {link.label}
        </Text>
      ))}

    </div>
  </div>

  <!-- Menu mobile -->
  <div
    id="mobileMenu"
    class="hidden border-t border-neutral-200/60 bg-[#f2f0e8] lg:hidden"
  >
    <div class="flex flex-col gap-4 px-6 py-5 text-[0.9rem] uppercase tracking-[0.08em] md:px-12">

      {menuLinks.map((link) => (
        <Text
          tag="a"
          href={link.href}
          variant="textBase"
          class={`transition-colors ${
            currentPath === link.href
              ? "font-semibold text-black"
              : "text-neutral-700 hover:text-black"
          }`}
        >
          {link.label}
        </Text>
      ))}

    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById("hamburgerBtn");
  const menu = document.getElementById("mobileMenu");

  if (btn && menu) {
    btn.addEventListener("click", () => {
      const isHidden = menu.classList.toggle("hidden");
      btn.setAttribute("aria-expanded", String(!isHidden));
    });
  }
</script>