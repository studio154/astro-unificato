---
import Text from "@/components/fundations/elements/Text.astro";

// Recuperiamo la chiave pubblica usando il tuo nome esatto di variabile
const siteKey = import.meta.env.CLOUDFLARE_TURNSTILE_SITEKEY;
---

<!-- w-full impedisce di sforare a destra su mobile. Rimosse le classi dark: per evitare lo sfondo nero -->
<section
    class="w-full max-w-3xl mx-auto rounded-3xl border border-gray-300/60 p-4 sm:p-8 shadow-sm bg-white/90 backdrop-blur-sm"
>
    <Text
        tag="h2"
        variant="textXL"
        class="mb-2 font-serif text-center text-base-900"
    >
        Informazioni e disponibilità
    </Text>

    <p
        class="mb-8 font-serif text-center text-base-700 text-sm max-w-md mx-auto uppercase tracking-wider leading-relaxed"
    >
        Scrivimi per informazioni, disponibilità o per pianificare una
        consulenza o una sessione fotografica.
    </p>

    <form id="contact-form" class="grid gap-5 w-full" autocomplete="on">
        <input
            type="hidden"
            name="subject"
            value="Richiesta da sito contatti"
        />
        <!-- Honeypot Antispam -->
        <div class="sr-only">
            <label for="website">Non compilare questo campo</label>
            <input
                id="website"
                name="website"
                type="text"
                autocomplete="off"
                tabindex="-1"
            />
        </div>

        <label
            class="grid gap-1 text-xs uppercase tracking-wider font-medium text-base-700"
        >
            Nome
            <input
                name="name"
                type="text"
                placeholder="Mario Rossi"
                required
                class="input-field"
            />
        </label>

        <label
            class="grid gap-1 text-xs uppercase tracking-wider font-medium text-base-700"
        >
            Email
            <input
                name="email"
                type="email"
                placeholder="nome@example.com"
                required
                class="input-field"
            />
        </label>

        <label
            class="grid gap-1 text-xs uppercase tracking-wider font-medium text-base-700"
        >
            Messaggio
            <textarea
                name="message"
                rows="6"
                placeholder="Scrivi il tuo messaggio..."
                required
                class="input-field"></textarea>
        </label>

        <!-- Turnstile widget -->
        <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light">
        </div>

        <div>
            <button type="submit" class="btn-submit">Invia messaggio</button>
        </div>

        <div id="form-status" class="hidden rounded px-4 py-2 mt-2 text-sm">
        </div>
    </form>
</section>

<script>
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const status = document.getElementById("form-status") as HTMLDivElement;
    const submitButton = form.querySelector(
        "button[type=submit]",
    ) as HTMLButtonElement;

    form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const nameInput = form.querySelector(
            'input[name="name"]',
        ) as HTMLInputElement;
        const emailInput = form.querySelector(
            'input[name="email"]',
        ) as HTMLInputElement;
        const messageInput = form.querySelector(
            'textarea[name="message"]',
        ) as HTMLTextAreaElement;
        const websiteInput = form.querySelector(
            'input[name="website"]',
        ) as HTMLInputElement;

        if (websiteInput && websiteInput.value) return;

        // Recupero token sicuro
        const turnstileInput = form.querySelector(
            'input[name="cf-turnstile-response"]',
        ) as HTMLInputElement;
        let turnstileToken =
            turnstileInput?.value || (window as any).turnstile?.getResponse();

        // Fallback automatico su localhost se il widget non ha fatto in tempo a calcolare il token
        if (
            !turnstileToken &&
            (window.location.hostname === "localhost" ||
                window.location.hostname === "127.0.0.1")
        ) {
            turnstileToken = "1x0000000000000000000000000000000AA";
        }

        const payload = {
            name: nameInput?.value,
            email: emailInput?.value,
            message: messageInput?.value,
            turnstileToken: turnstileToken,
        };

        status.classList.add("hidden");
        status.className = "rounded px-4 py-2 mt-2 text-sm hidden";

        submitButton.disabled = true;
        submitButton.textContent = "Invio in corso...";

        try {
            const res = await fetch("/api/contact", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload),
            });

            const result = await res.json();
            if (!res.ok)
                throw new Error(result.error || "Errore durante l'invio.");

            status.textContent =
                result.message || "Messaggio inviato con successo!";
            status.className =
                "rounded px-4 py-2 mt-2 text-sm bg-green-100 text-green-900 block";

            form.reset();
            (window as any).turnstile?.reset();
        } catch (err: any) {
            status.textContent = err.message;
            status.className =
                "rounded px-4 py-2 mt-2 text-sm bg-red-100 text-red-900 block";
            (window as any).turnstile?.reset();
        } finally {
            submitButton.disabled = false;
            submitButton.textContent = "Invia messaggio";
        }
    });
</script>

<style>
    .input-field {
        border: 1px solid #e5e7eb; /* Grigio molto leggero e raffinato */
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
        width: 100%;
        background-color: #ffffff; /* Forza lo sfondo bianco sempre, addio nero! */
        color: #1a1a1a; /* Testo scuro sempre leggibile */
        font-family: sans-serif;
        font-size: 1rem;
        margin-top: 0.25rem;
        transition: border-color 0.2s;
    }
    .input-field:focus {
        outline: none;
        border-color: #000000; /* Il bordo diventa nero minimal quando scrivi */
    }
    .btn-submit {
        border-radius: 9999px; /* Arrotondato premium */
        padding: 0.75rem 2.5rem;
        background: #000000; /* Nero puro */
        color: white;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-size: 0.875rem;
        cursor: pointer;
        transition: opacity 0.2s;
        margin-top: 0.5rem;
        width: auto;
    }
    .btn-submit:hover {
        opacity: 0.85;
    }
    .btn-submit:disabled {
        opacity: 0.6;
        background: #555555;
        cursor: not-allowed;
    }
</style>
