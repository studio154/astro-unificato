---
import Text from "@/components/fundations/elements/Text.astro";

// Recuperiamo la chiave pubblica usando il tuo nome esatto di variabile
const siteKey = import.meta.env.CLOUDFLARE_TURNSTILE_SITEKEY;
---

<section
    class="max-w-3xl mx-auto rounded-3xl border border-gray-300 p-6 shadow-lg bg-white/80 dark:bg-slate-950/80"
>
    <Text
        tag="h2"
        variant="textXL"
        class="mb-4 font-serif text-center text-base-900 dark:text-white"
    >
        Informazioni e disponibilità
    </Text>
    <Text
        tag="p"
        variant="textBase"
        class="mb-12 font-serif text-center text-base-900 dark:text-white"
    >
        Scrivimi per informazioni, disponibilità o per pianificare una sessione
        fotografica.
    </Text>

    <form id="contact-form" class="grid gap-4" autocomplete="on">
        <input
            type="hidden"
            name="subject"
            value="Richiesta da sito contatti"
        />
        <!-- Honeypot Antispam -->
        <div class="sr-only">
            <label for="website">Non compilare questo campo</label>
            <input
                id="website"
                name="website"
                type="text"
                autocomplete="off"
                tabindex="-1"
            />
        </div>

        <label class="grid gap-1">
            Nome
            <input
                name="name"
                type="text"
                placeholder="Mario Rossi"
                required
                class="input-field"
            />
        </label>

        <label class="grid gap-1">
            Email
            <input
                name="email"
                type="email"
                placeholder="nome@example.com"
                required
                class="input-field"
            />
        </label>

        <label class="grid gap-1">
            Messaggio
            <textarea
                name="message"
                rows="6"
                placeholder="Scrivi il tuo messaggio..."
                required
                class="input-field"></textarea>
        </label>

        <!-- Turnstile widget -->
        <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light">
        </div>

        <button type="submit" class="btn-submit">Invia messaggio</button>

        <div id="form-status" class="hidden rounded px-4 py-2 mt-2 text-sm">
        </div>
    </form>
</section>

<script>
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const status = document.getElementById("form-status") as HTMLDivElement;
    const submitButton = form.querySelector(
        "button[type=submit]",
    ) as HTMLButtonElement;

    form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const nameInput = form.querySelector(
            'input[name="name"]',
        ) as HTMLInputElement;
        const emailInput = form.querySelector(
            'input[name="email"]',
        ) as HTMLInputElement;
        const messageInput = form.querySelector(
            'textarea[name="message"]',
        ) as HTMLTextAreaElement;
        const websiteInput = form.querySelector(
            'input[name="website"]',
        ) as HTMLInputElement;

        if (websiteInput && websiteInput.value) return;

        // Recupero token sicuro
        const turnstileInput = form.querySelector(
            'input[name="cf-turnstile-response"]',
        ) as HTMLInputElement;
        let turnstileToken =
            turnstileInput?.value || (window as any).turnstile?.getResponse();

        // Fallback automatico su localhost se il widget non ha fatto in tempo a calcolare il token
        if (
            !turnstileToken &&
            (window.location.hostname === "localhost" ||
                window.location.hostname === "127.0.0.1")
        ) {
            turnstileToken = "1x0000000000000000000000000000000AA";
        }

        const payload = {
            name: nameInput?.value,
            email: emailInput?.value,
            message: messageInput?.value,
            turnstileToken: turnstileToken,
        };

        status.classList.add("hidden");
        status.className = "rounded px-4 py-2 mt-2 text-sm hidden";

        submitButton.disabled = true;
        submitButton.textContent = "Invio in corso...";

        try {
            const res = await fetch("/api/contact", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload),
            });

            const result = await res.json();
            if (!res.ok)
                throw new Error(result.error || "Errore durante l'invio.");

            status.textContent =
                result.message || "Messaggio inviato con successo!";
            status.className =
                "rounded px-4 py-2 mt-2 text-sm bg-green-100 text-green-900 block";

            form.reset();
            (window as any).turnstile?.reset();
        } catch (err: any) {
            status.textContent = err.message;
            status.className =
                "rounded px-4 py-2 mt-2 text-sm bg-red-100 text-red-900 block";
            (window as any).turnstile?.reset();
        } finally {
            submitButton.disabled = false;
            submitButton.textContent = "Invia messaggio";
        }
    });
</script>

<style>
    .input-field {
        border: 1px solid #ccc;
        border-radius: 0.75rem;
        padding: 0.75rem;
        width: 100%;
        background-color: transparent;
    }
    .btn-submit {
        border-radius: 9999px; /* Arrotondato premium */
        padding: 0.75rem 1.5rem;
        background: #000000; /* Nero puro */
        color: white;
        font-weight: bold;
        cursor: pointer;
        transition:
            background-color 0.2s,
            opacity 0.2s;
    }
    .btn-submit:hover {
        background: #1a1a1a; /* Schiarisce leggermente al passaggio */
    }
    .btn-submit:disabled {
        opacity: 0.6;
        background: #555555;
        cursor: not-allowed;
    }
</style>
