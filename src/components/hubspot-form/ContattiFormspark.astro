<section class="py-10 px-3 md:py-5 md:px-6">
  <div class="w-full max-w-2xl mx-auto">

    <div class="mb-10 text-center">
      <p class="text-sm uppercase tracking-[0.25em] text-slate-500 mb-3">
        Contatti
      </p>

      <h2
        class="font-serif text-4xl md:text-5xl font-light leading-tight text-slate-950"
        style="font-family: 'Newsreader', serif;"
      >
        Informazioni e disponibilità
      </h2>

      <p class="mt-6 text-lg leading-relaxed text-slate-600 max-w-xl mx-auto">
        Scrivimi per informazioni,
disponibilità o per pianificare una sessione fotografica.
      </p>
    </div>

    <form
      action="https://submit-form.com/ZSgDwLQLv"
      method="POST"
      class="space-y-6 rounded-2xl border border-slate-200 bg-white p-5 md:p-8"
    >

      <!-- Honeypot -->
      <input
        type="text"
        name="_gotcha"
        class="hidden"
        tabindex="-1"
        autocomplete="off"
      />

      <!-- Redirect -->
      <input
        type="hidden"
        name="_redirect"
        value="https://www.eliocarchidi.com/grazie/"
      />

      <!-- Nome -->
      <div>
        <label
          for="nome"
          class="mb-2 block text-sm font-medium text-slate-700"
        >
          Nome *
        </label>

        <input
          id="nome"
          type="text"
          name="nome"
          required
          autocomplete="name"
          placeholder="Il tuo nome"
          class="w-full rounded-md border border-slate-300 bg-white px-4 py-3 text-base text-slate-900 outline-none transition focus:border-slate-900 focus:ring-1 focus:ring-slate-900"
        />
      </div>

      <!-- Email -->
      <div>
        <label
          for="email"
          class="mb-2 block text-sm font-medium text-slate-700"
        >
          Email *
        </label>

        <input
          id="email"
          type="email"
          name="email"
          required
          autocomplete="email"
          placeholder="nome@email.com"
          class="w-full rounded-md border border-slate-300 bg-white px-4 py-3 text-base text-slate-900 outline-none transition focus:border-slate-900 focus:ring-1 focus:ring-slate-900"
        />
      </div>

      <!-- Messaggio -->
      <div>
        <label
          for="messaggio"
          class="mb-2 block text-sm font-medium text-slate-700"
        >
          Messaggio *
        </label>

        <textarea
          id="messaggio"
          name="messaggio"
          rows="7"
          required
          placeholder="Scrivi qui la tua richiesta..."
          class="w-full rounded-md border border-slate-300 bg-white px-4 py-3 text-base leading-relaxed text-slate-900 outline-none transition resize-none focus:border-slate-900 focus:ring-1 focus:ring-slate-900"
        ></textarea>
      </div>

      <!-- Turnstile -->
      <div class="flex justify-center pt-2">
        <div
          class="cf-turnstile"
          data-sitekey="0x4AAAAAAC8h4eqJDvK07CAM"
        ></div>
      </div>

      <!-- Submit -->
      <div class="pt-2">
        <button
          type="submit"
          class="group inline-flex w-full items-center justify-center rounded-md bg-slate-950 px-6 py-3 text-sm font-medium tracking-wide text-white transition hover:bg-slate-800"
        >
          Invia messaggio

          <span class="ml-2 transition-transform duration-300 group-hover:translate-x-1">
            →
          </span>
        </button>
      </div>

    </form>
  </div>
</section>

<script
  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  async
  defer
></script>