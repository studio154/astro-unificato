---
import { AstroSeo } from "@astrolib/seo";

const {
  title,
  description,
  canonical,
  image,
  ogType = "website",
} = Astro.props;

const defaultTitle = "Elio Leonardo Carchidi | Fotografo di Ritratto a Roma";
const defaultDesc =
  "Da oltre 40 anni realizzo ritratti fotografici con luce naturale a Roma.";

const normalizeCanonical = (value) => {
  const url = new URL(value, Astro.site);

  if (url.origin === Astro.site.origin && url.pathname !== "/") {
    url.pathname = url.pathname.replace(/\/+$/, "");
  }

  return url.href;
};

const canonicalUrl = normalizeCanonical(
  canonical || Astro.url.pathname
);

const ogImage =
  image?.url ||
  image ||
  "https://media.eliocarchidi.com/uploads/2026/03/blog-fotografia-elio-carchidi-bg-c.jpg";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://www.eliocarchidi.com/#person",
      name: "Elio Leonardo Carchidi",
      url: "https://www.eliocarchidi.com/",
      image: ogImage,
      jobTitle: "Fotografo di ritratto",
      worksFor: {
        "@id": "https://www.eliocarchidi.com/#organization",
      },
      sameAs: [
        "https://www.linkedin.com/in/eliocarchidi",
        "https://studio154.it",
      ],
    },
    {
      "@type": "ProfessionalService",
      "@id": "https://www.eliocarchidi.com/#organization",
      name: "Studio Elio Carchidi",
      url: "https://www.eliocarchidi.com/",
      image: ogImage,
      founder: {
        "@id": "https://www.eliocarchidi.com/#person",
      },
      areaServed: "Roma",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Roma",
        addressCountry: "IT",
      },
    },
    {
      "@type": "WebSite",
      "@id": "https://www.eliocarchidi.com/#website",
      url: "https://www.eliocarchidi.com/",
      name: "Elio Leonardo Carchidi",
      inLanguage: "it-IT",
      publisher: {
        "@id": "https://www.eliocarchidi.com/#organization",
      },
    },
  ],
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta name="theme-color" content="#ffffff" />

<AstroSeo
  title={title || defaultTitle}
  description={description || defaultDesc}
  canonical={canonicalUrl}
  openGraph={{
    url: canonicalUrl,
    title: title || defaultTitle,
    description: description || defaultDesc,
    images: [
      {
        url: ogImage,
        width: 1200,
        height: 630,
        alt: title || defaultTitle,
        type: "image/jpeg",
      },
    ],
    site_name: "Elio Leonardo Carchidi - Atelier Fotografico",
    type: ogType,
    locale: "it_IT",
  }}
  twitter={{
    handle: "@eliocarchidi",
    site: "@eliocarchidi",
    cardType: "summary_large_image",
  }}
/>

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />