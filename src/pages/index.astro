---
import LayoutLandingFull from "@/layouts/LayoutLandingFull.astro";
import { Image } from "astro:assets";
import ImmagineEdizioni from "../images/edizioni/cornici-atelier-gallery-edizioni-bn1.png";
import ImmagineSessioni from "../images/atelier/foto-edizioni-cornici-gallerie-fotografiche.png";
import Text from "../components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
---

<LayoutLandingFull
  title="Ritratti professionali per aziende, executive e professionisti a Roma"
  description="Sessioni fotografiche essenziali e curate per professionisti, manager, team aziendali e clienti internazionali. Disponibile in studio o presso aziende e hotel a Roma."
  image="/2026/05/foto-ritratto-corporate-avvocato-pellegrino-3.jpg"
>

  <!-- INTRO -->
  <section class="grid gap-12 md:grid-cols-2 md:gap-20">

    <div>
      <p class="mb-3 text-sm uppercase tracking-[0.25em] text-slate-500">
        Ritratto Professionale
      </p>

      <h2
        class="font-serif text-4xl font-light leading-tight text-slate-950"
        style="font-family: 'Newsreader', serif;"
      >
        Ritratti professionali costruiti attorno alla presenza.
      </h2>
    </div>

    <div class="space-y-6 text-lg leading-relaxed text-slate-600">

      <p>
        Realizzo ritratti professionali per aziende, professionisti,
        executive e clienti internazionali che desiderano un’immagine
        sobria, autorevole e contemporanea.
      </p>

      <p>
        Ogni sessione è progettata per creare fotografie utilizzabili
        per LinkedIn, stampa, comunicazione aziendale, conferenze e profili professionali.
      </p>

      <p>
        Lavoro principalmente a Roma, in studio o direttamente presso
        aziende, hotel e location selezionate.
      </p>

    </div>

  </section>

  <!-- SERVICES -->
  <section class="mt-32">

    <div class="mb-12">
      <p class="mb-3 text-sm uppercase tracking-[0.25em] text-slate-500">
        Servizi
      </p>

      <h2
        class="font-serif text-4xl font-light text-slate-950"
        style="font-family: 'Newsreader', serif;"
      >
        Sessioni fotografiche per professionisti e aziende
      </h2>
    </div>

    <div class="grid gap-8 md:grid-cols-3">

      <div class="rounded-3xl border border-neutral-200/50 bg-white/10 p-8 transition-all duration-300 hover:border-neutral-300/70 hover:bg-white/20">

        <h3 class="text-xl font-medium text-slate-950">
          Ritratti Executive
        </h3>

        <p class="mt-4 leading-relaxed text-slate-600">
          Ritratti individuali per manager, avvocati, consulenti,
          imprenditori e professionisti. Fotografie autorevoli.
        </p>
        <a
  href="/galleria/immagini/vip/"
  class="not-prose no-underlinegroup mt-6 inline-flex items-center text-sm tracking-[0.08em] text-slate-500 transition-colors duration-300 hover:text-black"
>
  

  <span class="ml-2 transition-transform duration-300 group-hover:translate-x-1">
    →
  </span>
</a>

      </div>

      <div class="rounded-3xl border border-neutral-200/50 bg-white/10 p-8 transition-all duration-300 hover:border-neutral-300/70 hover:bg-white/20">

        <h3 class="text-xl font-medium text-slate-950">
          Ritratti Aziendali
        </h3>

        <p class="mt-4 leading-relaxed text-slate-600">
          Sessioni fotografiche coordinate per team aziendali,
          siti web, presentazioni e comunicazione interna.
        </p>
        <a
  href="/galleria/immagini/corporate/"
  class="not-prose no-underline group mt-6 inline-flex items-center text-sm tracking-[0.08em] text-slate-500 transition-colors duration-300 hover:text-black"
>
 <span class="ml-2 transition-transform duration-300 group-hover:translate-x-1">
    →
  </span>
</a>

      </div>

      <div class="rounded-3xl border border-neutral-200/50 bg-white/10 p-8 transition-all duration-300 hover:border-neutral-300/70 hover:bg-white/20">

        <h3 class="text-xl font-medium text-slate-950">
          Ritratto Professionale
        </h3>

        <p class="mt-4 leading-relaxed text-slate-600">
          Immagini professionali per creativi, speaker,
          consulenti e professionisti indipendenti.
        </p>
        <a
  href="/galleria/immagini/fine-art/"
  class="group mt-6 not-prose no-underline inline-flex items-center gap-2 text-sm tracking-wide text-slate-500 transition-colors duration-300 hover:text-slate-900"
>
  <span class="ml-2 transition-transform duration-300 group-hover:translate-x-1">
    →
  </span>
</a>

      </div>

    </div>

  </section>

  <!-- APPROACH -->
  <section class="mt-32 grid gap-16 md:grid-cols-2">

    <div>

  <p class="mb-3 text-sm uppercase tracking-[0.25em] text-slate-500">
    Approccio
  </p>

  <h2
    class="font-serif text-4xl font-light leading-tight text-slate-950"
    style="font-family: 'Newsreader', serif;"
  >
    Un approccio essenziale al ritratto.
  </h2>

</div>

<div class="space-y-6 text-lg leading-relaxed text-slate-600">

  <p>
    Da oltre quarant’anni lavoro sul ritratto come forma di presenza,
    attenzione e misura.
  </p>

  <p>
    Il mio lavoro nasce dalla fotografia editoriale e fine art,
    con un approccio costruito sulla luce naturale,
    sul tempo e sulla naturalezza dell’immagine.
  </p>

  <p>
    L’obiettivo non è creare fotografie artificiali o aggressive,
    ma immagini professionali credibili, sobrie e durature,
    sviluppate con attenzione alla persona,
    al contesto e all’utilizzo finale delle immagini.
  </p>

</div>

  </section>

   <!-- ATELIER -->
   <section>

    <p class="mb-3 text-sm uppercase tracking-[0.25em] text-slate-500">
    Atelier
  </p>

  <h2
    class="font-serif text-4xl font-light leading-tight text-slate-950"
    style="font-family: 'Newsreader', serif;"
  >
    Sessioni private ed edizioni d’autore
  </h2>
<div class="mt-4 md:mt-2 grid gap-16 grid-cols-1 lg:grid-cols-2 max-w-5xl mx-auto">
        
        <div class="flex flex-col items-center text-center">
          <a href="/atelier/sessioni-private/" class="block overflow-hidden">
            <Image
              src={ImmagineSessioni}
              alt="Sessioni Private di Ritratto - Elio Leonardo Carchidi"
              width={610}
              height={410}
              class="w-full"
              loading="lazy"
            />
          </a>
          <h2
    class="font-serif text-4xl font-light leading-tight text-slate-950"
    style="font-family: 'Newsreader', serif;"
  >
    Sessioni Private di Ritratto
  </h2>
          <Text
            tag="p"
            variant="textSmall"
            class="mt-2 text-base max-w-lg"
          >
            Un'esperienza di ritratto costruita intorno alla tua presenza, con luce, tempo e attenzione dedicati.
          </Text>
          <Button
            isLink={true}
            href="/atelier/sessioni-private/"
            size="lg"
            variant="default"
            class="mt-4"
          >
            Prenota il tuo ritratto
          </Button>
        </div>

        <div class="flex flex-col items-center text-center">
          <a href="/atelier/edizioni/" class="block overflow-hidden">
            <Image
              src={ImmagineEdizioni}
              alt="Edizioni d'Autore - Elio Leonardo Carchidi"
              width={610}
              height={410}
              class="w-full"
              loading="eager"
              fetchpriority="high"
            />
          </a>
          <h2
    class="font-serif text-4xl font-light leading-tight text-slate-950"
    style="font-family: 'Newsreader', serif;"
  >
    Edizioni d'Autore
  </h2>
          <Text
            tag="p"
            variant="textSmall"
            class="mt-2 text-base max-w-lg"
          >
            Ritratti e stampe già realizzati, disponibili in edizioni curate e pronte a entrare nel tuo spazio.
          </Text>
          <Button
            isLink={true}
            href="/atelier/edizioni/"
            size="lg"
            variant="default"
            class="mt-4"
          >
            Esplora le edizioni
          </Button>
        </div>
</section>

  <!-- CTA -->
  <section class="mt-32 rounded-[2rem] bg-slate-950 px-10 py-20 text-center text-white">

    <p class="mb-4 text-sm uppercase tracking-[0.25em] text-slate-400">
      Studio fotografico a Roma
    </p>

    <h2
  class="mx-auto max-w-3xl font-serif text-4xl font-medium leading-tight tracking-tight text-neutral-50 md:text-5xl"
  style="font-family: 'Newsreader', serif;"
>
  Prenota una sessione fotografica professionale.
</h2>

    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">
      Disponibile per ritratti individuali, team aziendali,
      personal branding e clienti internazionali a Roma.
    </p>

    <div class="mt-10 flex flex-wrap justify-center gap-4">

      <a
        href="/contatti"
        class="inline-flex items-center justify-center rounded-full bg-white px-8 py-4 text-sm font-medium tracking-wide text-slate-950 transition hover:bg-slate-200"
      >
        Richiedi informazioni
      </a>

      <a
        href="/portfolio"
        class="inline-flex items-center justify-center rounded-full border border-slate-600 px-8 py-4 text-sm font-medium tracking-wide text-white transition hover:border-white"
      >
        Portfolio
      </a>

    </div>

  </section>
 
        

      </div>

</LayoutLandingFull>