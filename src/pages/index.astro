---
import LayoutLandingFull from "@/layouts/LayoutLandingFull.astro";
import { Image } from "astro:assets";
import ImmagineEdizioni from "../images/edizioni/cornici-atelier-gallery-edizioni-bn1.png";
import ImmagineSessioni from "../images/atelier/foto-edizioni-cornici-gallerie-fotografiche.png";
import Text from "../components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
---

<LayoutLandingFull
  title="Ritratti d’autore a Roma"
  description="Da oltre quarant’anni realizzo ritratti a Roma per professionisti, personalità e persone che desiderano un’immagine autentica. Sessioni guidate, in atelier o in location."
  image="/2026/ritratto-professionale-linkedin-social-profile.jpeg"
>

  <!-- INTRO -->
  <section class="grid gap-12 md:grid-cols-2 md:gap-20">

    <div>
      <p class="mb-3 text-sm uppercase tracking-[0.25em] text-slate-500">
        Sessioni su commissione
      </p>

      <h2
        class="font-serif text-4xl font-light leading-tight text-slate-950"
        style="font-family: 'Newsreader', serif;"
      >
        Un ritratto personale, autentico, riconoscibile.
      </h2>
    </div>

    <div class="space-y-6 text-lg leading-relaxed text-slate-600">

      <p>
        Realizzo ritratti su commissione per professionisti, personalità e
        persone che desiderano un’immagine autentica e senza tempo.
      </p>

      <p>
        Ogni sessione è guidata e costruita intorno alla persona: dalla
        preparazione alla scelta della luce, fino alle immagini finali.
      </p>

      <p>
        Ti accolgo nel mio atelier a Roma o realizzo il ritratto in una
        location selezionata.
      </p>

      <p class="border-t border-neutral-200 pt-5 text-sm">
        Per eventi e produzioni fotografiche aziendali, visita
        <a
          href="https://studio154.it"
          class="underline underline-offset-4 hover:text-slate-950"
        >Studio154</a>.
      </p>
    </div>

  </section>


  <!-- SERVICES -->
  <section class="mt-32">

    <div class="mb-12">
      <p class="mb-3 text-sm uppercase tracking-[0.25em] text-slate-500">
        Servizi
      </p>

      <h2
        class="font-serif text-4xl font-light text-slate-950"
        style="font-family: 'Newsreader', serif;"
      >
        Scegli il tuo percorso
      </h2>
    </div>

    <div class="grid gap-8 md:grid-cols-3">

      <!-- PERSONALITÀ -->
      <div
        class="rounded-3xl border border-neutral-200/50 bg-white/10 p-8 transition-all duration-300 hover:border-neutral-300/70 hover:bg-white/50"
      >

        <a href="/galleria/immagini/vip">
          <img
            class="rounded-2xl"
            alt="Sessioni fotografiche dedicate a personaggi famosi, artisti, manager e protagonisti dello spettacolo"
            src="https://media.eliocarchidi.com/uploads/2026/ritratto-fotografico-cristina-chiabotto-2.jpg"
          />
        </a>

        <h3 class="text-xl font-medium text-slate-950">
          Ritratti di Personalità
        </h3>

        <p class="mt-4 leading-relaxed text-slate-600">
          Sessioni fotografiche dedicate a vip, artisti e protagonisti
          della cultura, dello sport e dello spettacolo.
        </p>

        <a
          href="/galleria/immagini/vip"
          class="not-prose no-underline group mt-6 inline-flex items-center text-sm tracking-[0.08em] text-slate-500 transition-colors duration-300 hover:text-black"
        >
          <span class="ml-2 transition-transform duration-300 group-hover:translate-x-1">
            →
          </span>
        </a>

      </div>


      <!-- EXECUTIVE -->
      <div
        class="rounded-3xl border border-neutral-200/50 bg-white/10 p-8 transition-all duration-300 hover:border-neutral-300/70 hover:bg-white/50"
      >

        <a href="/galleria/immagini/corporate">
          <img
            class="rounded-2xl"
            alt="Ritratti professionali LinkedIn per avvocati, manager e professionisti"
            src="https://media.eliocarchidi.com/uploads/2026/05/foto-ritratto-corporate-avvocato-pellegrino-squared.jpg"
          />
        </a>

        <h3 class="text-xl font-medium text-slate-950">
          Ritratti Executive
        </h3>

        <p class="mt-4 leading-relaxed text-slate-600">
          Ritratti individuali per manager, avvocati, consulenti,
          imprenditori e professionisti. Fotografie autorevoli.
        </p>

        <a
          href="/galleria/immagini/corporate"
          class="not-prose no-underline group mt-6 inline-flex items-center text-sm tracking-[0.08em] text-slate-500 transition-colors duration-300 hover:text-black"
        >
          <span class="ml-2 transition-transform duration-300 group-hover:translate-x-1">
            →
          </span>
        </a>

      </div>


      <!-- PROFESSIONALE -->
      <div
        class="rounded-3xl border border-neutral-200/50 bg-white/10 p-8 transition-all duration-300 hover:border-neutral-300/70 hover:bg-white/50"
      >

        <a href="/galleria/immagini/fine-art">
          <img
            class="rounded-2xl"
            alt="Ritratti professionali per creator digitali, attori e attrici"
            src="https://media.eliocarchidi.com/uploads/2026/ritratto-corporate-headshot-tono-basso.jpeg"
          />
        </a>

        <h3 class="text-xl font-medium text-slate-950">
          Ritratto Professionale
        </h3>

        <p class="mt-4 leading-relaxed text-slate-600">
          Immagini professionali per creativi, attori e attrici,
          creator e artisti indipendenti.
        </p>

        <a
          href="/galleria/immagini/fine-art"
          class="group mt-6 not-prose no-underline inline-flex items-center gap-2 text-sm tracking-wide text-slate-500 transition-colors duration-300 hover:text-slate-900"
        >
          <span class="ml-2 transition-transform duration-300 group-hover:translate-x-1">
            →
          </span>
        </a>

      </div>

    </div>

  </section>


  <!-- APPROACH -->
  <section class="mt-32 grid gap-16 md:grid-cols-2">

    <div>

      <p class="mb-3 text-sm uppercase tracking-[0.25em] text-slate-500">
        Approccio
      </p>

      <h2
        class="font-serif text-4xl font-light leading-tight text-slate-950"
        style="font-family: 'Newsreader', serif;"
      >
        Un approccio essenziale al ritratto.
      </h2>

    </div>

    <div class="space-y-6 text-lg leading-relaxed text-slate-600">

      <p>
        Da oltre 45 anni lavoro sul ritratto come forma di presenza,
        attenzione e misura.
      </p>

      <p>
        Il mio lavoro nasce dalla fotografia editoriale e fine art,
        con un approccio costruito sulla luce naturale,
        sul tempo e sulla naturalezza dell’immagine.
      </p>

      <p>
        L’obiettivo non è creare fotografie artificiali o aggressive,
        ma immagini professionali credibili, sobrie e durature,
        sviluppate con attenzione alla persona,
        al contesto e all’utilizzo finale delle immagini.
      </p>

    </div>

  </section>


  <!-- ATELIER -->
  <section>

    <p class="mb-3 text-sm uppercase tracking-[0.25em] text-slate-500">
      Atelier
    </p>

    <h2
      class="font-serif text-4xl font-light leading-tight text-slate-950"
      style="font-family: 'Newsreader', serif;"
    >
      Sessioni private ed edizioni d’autore
    </h2>

    <div class="mt-4 grid max-w-5xl grid-cols-1 gap-16 md:mt-2 lg:grid-cols-2 mx-auto">

      <!-- SESSIONI PRIVATE -->
      <div class="flex flex-col items-center text-center">

        <a href="/atelier/sessioni-private" class="block overflow-hidden">
          <Image
            src={ImmagineSessioni}
            alt="Sessioni Private di Ritratto - Elio Leonardo Carchidi"
            width={610}
            height={410}
            class="w-full"
            loading="lazy"
          />
        </a>

        <h2
          class="font-serif text-4xl font-light leading-tight text-slate-950"
          style="font-family: 'Newsreader', serif;"
        >
          Sessioni Private di Ritratto
        </h2>

        <Text
          tag="p"
          variant="textSmall"
          class="mt-2 max-w-lg text-base"
        >
          Un'esperienza di ritratto costruita intorno alla tua presenza,
          con luce, tempo e attenzione dedicati.
        </Text>

        <Button
          isLink={true}
          href="/atelier/sessioni-private"
          size="lg"
          variant="default"
          class="mt-4"
        >
          Prenota il tuo ritratto
        </Button>

      </div>


      <!-- EDIZIONI -->
      <div class="flex flex-col items-center text-center">

        <a href="/atelier/edizioni" class="block overflow-hidden">
          <Image
            src={ImmagineEdizioni}
            alt="Edizioni d'Autore - Elio Leonardo Carchidi"
            width={610}
            height={410}
            class="w-full"
            loading="eager"
            fetchpriority="high"
          />
        </a>

        <h2
          class="font-serif text-4xl font-light leading-tight text-slate-950"
          style="font-family: 'Newsreader', serif;"
        >
          Edizioni d'Autore
        </h2>

        <Text
          tag="p"
          variant="textSmall"
          class="mt-2 max-w-lg text-base"
        >
          Ritratti e stampe già realizzati, disponibili in edizioni curate
          e pronte a entrare nel tuo spazio.
        </Text>

        <Button
          isLink={true}
          href="/atelier/edizioni"
          size="lg"
          variant="default"
          class="mt-4"
        >
          Esplora le edizioni
        </Button>

      </div>

    </div>

  </section>


  <!-- CTA -->
  <section class="mt-32 rounded-[2rem] bg-slate-950 px-10 py-20 text-center text-white">

    <p class="mb-4 text-sm uppercase tracking-[0.25em] text-slate-400">
      Studio fotografico a Roma
    </p>

    <h2
      class="mx-auto max-w-3xl font-serif text-4xl font-medium leading-tight tracking-tight text-neutral-50 md:text-5xl"
      style="font-family: 'Newsreader', serif;"
    >
      Un ritratto costruito intorno a te.
    </h2>

    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">
      Per un profilo professionale, un progetto editoriale o una sessione
      d’autore, ogni ritratto nasce da un incontro.
    </p>

    <div class="mt-10 flex flex-wrap justify-center gap-4">

      <a
        href="/contatti"
        class="inline-flex items-center justify-center rounded-full bg-white px-8 py-4 text-sm font-medium tracking-wide text-slate-950 transition hover:bg-slate-200"
      >
        Parliamo del tuo ritratto
      </a>

      <a
        href="/portfolio"
        class="inline-flex items-center justify-center rounded-full border border-slate-600 px-8 py-4 text-sm font-medium tracking-wide text-white transition hover:border-white"
      >
        Portfolio
      </a>

    </div>

  </section>

</LayoutLandingFull>