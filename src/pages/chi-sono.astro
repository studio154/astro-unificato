---
import TeamLayout from "@/layouts/TeamLayout.astro";

// Import dell'immagine locale

const FotoElio =
  "https://media.eliocarchidi.com/uploads/2026/05/elio-leonardo-carchidi-studio.jpeg";

const frontmatter = {
  name: "Elio Leonardo Carchidi",
  role: "Fotografo ritrattista e pubblicitario a Roma",

  // SEO (passa al layout)
  title: "Chi sono",
  description:
    "Elio Leonardo Carchidi, fotografo di ritratto a Roma. Da oltre 40 anni realizza immagini essenziali e senza tempo, specializzato in fine art, corporate ed editoriale.",
  canonical: "https://www.eliocarchidi.com/chi-sono/",
  ogImage:
    "https://media.studio154.it/uploads/2026/05/elio-leonardo-carchidi-studio.jpeg",

  image: { url: FotoElio, alt: "Elio Leonardo Carchidi Fotografo esperto" },

  bio: `Da quasi 50 anni realizzo ritratti fotografici a Roma, combinando maestria tecnica, sensibilità artistica e cura della presenza.  
La mia fotografia nasce dalla luce naturale e dal tempo dedicato al soggetto: ogni immagine è essenziale, senza artifici, pensata per restituire autenticità e profondità.  

Fondatore di Studio154, collaboro con clienti e produzioni nazionali e internazionali, realizzando ritratti fine art, corporate ed editoriali.  
La mia filosofia si ispira alla profondità dei classici: “Fatti non foste a viver come bruti ma per seguir virtute e conoscenza” – un principio che guida il mio lavoro e la mia vita. 

Benvenuti nel mio studio: mettetevi comodi e lasciate che il ritratto parli di voi.`,

  socials: {
    linkedin: "https://www.linkedin.com/in/eliocarchidi",
    email: "mailto:info@eliocarchidi.com",
    website: "https://www.eliocarchidi.com",
  },
};
---

<TeamLayout frontmatter={frontmatter}>
  <section class="mx-auto max-w-xl px-6 pt-6 text-center md:pt-12">
    <a
      href="javascript:history.back()"
      class="mb-4 inline-flex items-center gap-1 text-xs text-gray-600 hover:text-gray-800"
    >
      &larr; Go back
    </a>

    <h1 class="mb-2 text-3xl font-semibold md:text-4xl">
      {frontmatter.name}
    </h1>

    <p class="mb-6 text-lg md:text-xl">
      {frontmatter.role}
    </p>

    <img
      src={frontmatter.image.url}
      alt={frontmatter.image.alt}
      class="mx-auto mb-6 w-full max-w-sm rounded-lg object-cover shadow-md"
      loading="eager"
    />

    <div class="mb-8 space-y-4 text-left">
      {
        frontmatter.bio
          .split("\n")
          .map((p) => <p class="font-serif leading-7 text-base-900">{p}</p>)
      }
    </div>
  </section>

  <section slot="cta">
    <div class="flex justify-center">
      <a
        href="/sessioni-private/"
        class="inline-block rounded-md bg-gray-900 px-6 py-3 font-medium text-white transition hover:bg-gray-800"
      >
        Prenota la tua sessione di ritratto
      </a>
    </div>
  </section>

  <section class="bg-gray-50 py-8 text-center">
    <p class="mb-2 text-base-600">Since 1976 – fotografia di ritratto</p>
    <p class="mb-1 text-base-900">
      Lo studio fotografico riceve esclusivamente su appuntamento
    </p>
    <p class="font-semibold">Studio154</p>
  </section>
</TeamLayout>
