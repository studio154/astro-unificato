---
import LayoutPulito from "../../layouts/LayoutPulito.astro";
---

<LayoutPulito
    title="Fine Art & Analogue"
    description="Progetti personali e su commissione in fotografia analogica e fine art."
>
    <section class="hero">
        <div class="hero-inner">
            <span class="eyebrow">Committenze / Ricerca</span>

            <h1>
                Fine Art <br />
                & Analogue
            </h1>

            <p class="intro">
                Progetti speciali su commissione e ricerca personale. La
                fotografia analogica come linguaggio lento, materico e
                permanente.
            </p>
        </div>
    </section>

    <section class="projects">
        <div class="section-heading">
            <span>Selezione</span>
            <h2>Ricerca & Progetti</h2>
        </div>

        <div class="projects-grid">
            <article class="project-card">
                <div class="image-placeholder">
                    <img
                        src="https://media.eliocarchidi.com/uploads/2026/04/ART-Donna-Viso-Occhi-Chiari.jpg"
                        alt="Silent Portraits"
                    />
                </div>
                <div class="project-meta">
                    <span>Fine Art Study</span>
                    <h3>Silent Portraits</h3>
                </div>
            </article>

            <article class="project-card">
                <div class="image-placeholder">
                    <img
                        src="https://media.eliocarchidi.com/uploads/2026/04/svetlana-intimo-bn-small.jpg"
                        alt="Light & Grain"
                    />
                </div>
                <div class="project-meta">
                    <span>Analog Series</span>
                    <h3>Light & Grain</h3>
                </div>
            </article>

            <article class="project-card">
                <div class="image-placeholder">
                    <img
                        src="https://media.eliocarchidi.com/uploads/2026/04/ART-Ritratto-Monica.jpg"
                        alt="Private Works"
                    />
                </div>
                <div class="project-meta">
                    <span>Commission</span>
                    <h3>Private Works</h3>
                </div>
            </article>
        </div>
    </section>

    <section class="closing">
        <p>
            La fotografia analogica non conserva il passato: lo trasforma in
            permanenza visiva.
        </p>
    </section>

    <style>
        .hero {
            min-height: 70vh;
            display: flex;
            align-items: flex-end;
            padding: 10rem 2rem 6rem;
        }

        .hero-inner {
            max-width: 980px;
            margin: 0 auto;
            width: 100%;
        }

        .eyebrow {
            font-size: 0.8rem;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            opacity: 0.5;
        }

        h1 {
            font-size: clamp(4rem, 10vw, 9rem);
            line-height: 0.9;
            letter-spacing: -0.06em;
            margin: 2rem 0;
        }

        .intro {
            max-width: 720px;
            font-size: 1.1rem;
            line-height: 1.9;
            opacity: 0.8;
        }

        .projects {
            padding: 8rem 2rem;
        }

        .section-heading {
            max-width: 1400px;
            margin: 0 auto 4rem;
        }

        .section-heading span {
            font-size: 0.75rem;
            text-transform: uppercase;
            opacity: 0.5;
            letter-spacing: 0.15em;
        }

        .section-heading h2 {
            font-size: clamp(2.5rem, 5vw, 5rem);
            margin-top: 1rem;
            letter-spacing: -0.04em;
        }

        .projects-grid {
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
        }

        .project-card {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .image-placeholder {
            aspect-ratio: 3 / 4;
            overflow: hidden;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.05);
        }

        .image-placeholder img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .project-meta span {
            font-size: 0.75rem;
            text-transform: uppercase;
            opacity: 0.5;
            letter-spacing: 0.12em;
        }

        .project-meta h3 {
            margin-top: 0.5rem;
            font-size: 1.2rem;
            font-weight: 500;
        }

        .closing {
            padding: 10rem 2rem;
            text-align: center;
        }

        .closing p {
            max-width: 720px;
            margin: 0 auto;
            font-size: 1.2rem;
            line-height: 1.8;
            opacity: 0.75;
        }

        @media (max-width: 900px) {
            .projects-grid {
                grid-template-columns: 1fr;
            }

            .hero {
                padding-top: 8rem;
            }
        }
    </style>
</LayoutPulito>
