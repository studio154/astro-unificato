---
import BaseLayout from "../../layouts/LayoutPulito.astro";
---

<BaseLayout
    title="Corporate & Stage"
    description="Ritratti istituzionali, corporate e fotografia per il mondo dello spettacolo."
>
    <section class="hero">
        <div class="hero-inner">
            <span class="eyebrow">Committenze / Istituzionale</span>

            <h1>
                Corporate <br />
                & Stage
            </h1>

            <p class="intro">
                Ritratti istituzionali, corporate e fotografia per il mondo
                dello spettacolo. Un approccio essenziale alla costruzione
                dell’identità visiva.
            </p>
        </div>
    </section>

    <section class="projects">
        <div class="section-heading">
            <span>Selezione</span>
            <h2>Ritratti & Istituzioni</h2>
        </div>

        <div class="projects-grid">
            <article class="project-card">
                <div class="image-placeholder">
                    <img
                        src="https://media.eliocarchidi.com/uploads/2026/04/C-immagine-corporate-semplice-9.jpg"
                        alt="Corporate portrait"
                    />
                </div>
                <div class="project-meta">
                    <span>Corporate Portrait</span>
                    <h3>Executive Series</h3>
                </div>
            </article>

            <article class="project-card">
                <div class="image-placeholder">
                    <img
                        src="https://media.eliocarchidi.com/uploads/2026/04/A-Giampiero-Ingrassia-Attore.jpg"
                        alt="Stage portrait"
                    />
                </div>
                <div class="project-meta">
                    <span>Stage Portrait</span>
                    <h3>Theater & Cinema</h3>
                </div>
            </article>

            <article class="project-card">
                <div class="image-placeholder">
                    <img
                        src="https://media.eliocarchidi.com/uploads/2026/04/A-amanda-lear-ritratto-in-posa.jpg"
                        alt="Institutional portrait"
                    />
                </div>
                <div class="project-meta">
                    <span>Institutional</span>
                    <h3>Public Figures</h3>
                </div>
            </article>
        </div>
    </section>

    <section class="closing">
        <p>
            La fotografia istituzionale non rappresenta soltanto il soggetto, ma
            costruisce il contesto in cui viene percepito.
        </p>
    </section>
</BaseLayout>

<style>
    :global(body) {
        background: var(--bg);
        color: var(--text);
    }

    .hero {
        min-height: 72vh;
        display: flex;
        align-items: flex-end;
        padding: 10rem 2rem 6rem;
    }

    .hero-inner {
        max-width: 980px;
        margin: 0 auto;
    }

    .eyebrow {
        font-size: 0.8rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        opacity: 0.5;
        margin-bottom: 2rem;
    }

    h1 {
        font-size: clamp(4rem, 10vw, 9rem);
        line-height: 0.9;
        letter-spacing: -0.06em;
        margin: 2rem 0;
    }

    .intro {
        max-width: 720px;
        font-size: 1.1rem;
        line-height: 1.9;
        opacity: 0.8;
    }

    .projects {
        padding: 8rem 2rem;
    }

    .section-heading {
        max-width: 1400px;
        margin: 0 auto 4rem;
    }

    .section-heading span {
        font-size: 0.75rem;
        text-transform: uppercase;
        opacity: 0.5;
        letter-spacing: 0.15em;
    }

    .section-heading h2 {
        font-size: clamp(2.5rem, 5vw, 5rem);
        margin-top: 1rem;
    }

    .projects-grid {
        max-width: 1400px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
    }

    .project-card {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .image-placeholder {
        aspect-ratio: 4 / 5;
        overflow: hidden;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.05);
    }

    .image-placeholder img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .project-meta span {
        font-size: 0.75rem;
        text-transform: uppercase;
        opacity: 0.5;
        letter-spacing: 0.12em;
    }

    .project-meta h3 {
        margin-top: 0.5rem;
        font-size: 1.2rem;
        font-weight: 500;
    }

    .closing {
        padding: 10rem 2rem;
        text-align: center;
    }

    .closing p {
        max-width: 720px;
        margin: 0 auto;
        font-size: 1.2rem;
        line-height: 1.8;
        opacity: 0.75;
    }

    @media (max-width: 900px) {
        .projects-grid {
            grid-template-columns: 1fr;
        }

        .hero {
            padding-top: 8rem;
        }
    }
</style>
