---
import BaseLayout from "../../layouts/LayoutPulito.astro";
---

<BaseLayout
    title="Corporate & Stage"
    description="Ritratti istituzionali, corporate e fotografia per il mondo dello spettacolo."
>
    <section class="hero">
        <div class="hero-inner">
            <span class="eyebrow">Committenze / Istituzionale</span>

            <h1>
                Corporate <br />
                & Stage
            </h1>

            <p class="intro">
                Ritratti istituzionali, corporate e fotografia per il mondo
                dello spettacolo. Un approccio essenziale alla costruzione
                dell’identità visiva, dove la presenza prevale sulla
                rappresentazione.
            </p>
        </div>
    </section>

    <section class="manifesto">
        <div class="grid">
            <div class="label">
                <span>02</span>
            </div>

            <div class="content">
                <h2>Credibilità e sottrazione</h2>

                <p>
                    Nel ritratto istituzionale la fotografia diventa struttura.
                    Non descrive, ma sostiene la percezione pubblica del
                    soggetto.
                </p>

                <p>
                    La luce è costruita per eliminare interferenze narrative,
                    lasciando emergere solo ciò che è necessario alla lettura
                    del ruolo.
                </p>
            </div>
        </div>
    </section>

    <section class="projects">
        <div class="section-heading">
            <span>Selezione</span>
            <h2>Ritratti & Istituzioni</h2>
        </div>

        <div class="projects-grid">
            <article class="project-card">
                <div class="image-placeholder">
                    <img
                        src="https://media.eliocarchidi.com/uploads/2026/04/C-immagine-corporate-semplice-9.jpg"
                        class="rounded-xl"
                    />
                </div>
                <div class="project-meta">
                    <span>Corporate Portrait</span>
                    <h3>Executive Series</h3>
                </div>
            </article>

            <article class="project-card">
                <div class="image-placeholder">
                    <img
                        src="https://media.eliocarchidi.com/uploads/2026/04/A-Giampiero-Ingrassia-Attore.jpg"
                        alt="ritratto istituzionale"
                        class="rounded-xl bg-gray-100"
                    />
                </div>
                <div class="project-meta">
                    <span>Stage Portrait</span>
                    <h3>Theater & Cinema</h3>
                </div>
            </article>

            <article class="project-card">
                <div class="image-placeholder">
                    <img
                        src="https://media.eliocarchidi.com/uploads/2026/04/A-amanda-lear-ritratto-in-posa.jpg"
                        alt="ritratto istituzionale"
                        class="rounded-xl bg-gray-100"
                    />
                </div>
                <div class="project-meta">
                    <span>Institutional</span>
                    <h3>Public Figures</h3>
                </div>
            </article>
        </div>
    </section>

    <section class="closing">
        <p>
            La fotografia istituzionale non rappresenta soltanto il soggetto, ma
            costruisce il contesto in cui viene percepito.
        </p>
    </section>
</BaseLayout>

<style>
    :global(body) {
        background: var(--bg);
        color: var(--text);
    }

    /* ==========================================
       HERO SECTION
       ========================================== */
    .hero {
        min-height: 72vh;
        display: flex;
        align-items: flex-end;
        padding: 10rem 2rem 6rem;
    }

    .hero-inner {
        max-width: 980px;
        margin: 0 auto;
        width: 100%;
    }

    .eyebrow {
        display: inline-block;
        font-size: 0.8rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        opacity: 0.5;
        margin-bottom: 2rem;
    }

    h1 {
        font-size: clamp(4rem, 10vw, 9rem);
        line-height: 0.9;
        letter-spacing: -0.06em;
        font-weight: 500;
        margin-bottom: 2rem;
    }

    .intro {
        max-width: 720px;
        font-size: 1.15rem;
        line-height: 1.9;
        opacity: 0.82;
    }

    /* ==========================================
       MANIFESTO SECTION
       ========================================== */
    .manifesto {
        padding: 8rem 2rem;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .grid {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 120px 1fr;
        gap: 4rem;
    }

    .label span {
        font-size: 0.9rem;
        opacity: 0.4;
    }

    .content h2 {
        font-size: clamp(2rem, 5vw, 4rem);
        line-height: 1;
        margin-bottom: 2rem;
        letter-spacing: -0.04em;
    }

    .content p {
        max-width: 760px;
        line-height: 1.9;
        opacity: 0.8;
        margin-bottom: 1.5rem;
    }

    /* ==========================================
       PROJECTS SECTION (GRIGLIA E CARD SIMMETRICHE)
       ========================================== */
    .projects {
        padding: 8rem 2rem;
    }

    .section-heading {
        max-width: 1400px;
        margin: 0 auto 4rem;
    }

    .section-heading span {
        opacity: 0.5;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        font-size: 0.75rem;
    }

    .section-heading h2 {
        margin-top: 1rem;
        font-size: clamp(2.5rem, 5vw, 5rem);
        letter-spacing: -0.05em;
    }

    /* La Griglia: blocca le colonne in modo simmetrico */
    .projects-grid {
        max-width: 1400px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        align-items: stretch; /* Obbliga le card ad avere la stessa altezza */
    }

    /* La Card: distribuisce lo spazio interno verticalmente */
    .project-card {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        height: 100%;
    }

    /* Il Contenitore Foto: aspect-ratio 3/4 per renderle più alte e slanciate */
    .image-placeholder {
        aspect-ratio: 3.5 / 5;
        background: linear-gradient(
            135deg,
            rgba(255, 255, 255, 0.06),
            rgba(255, 255, 255, 0.02)
        );
        border: 1px solid rgba(255, 255, 255, 0.08);
        overflow: hidden; /* Taglia tassativamente l'immagine in eccedenza */
        position: relative;
    }

    /* L'Immagine: riempie lo spazio senza subire distorsioni o allungamenti */
    .image-placeholder img {
        width: 100%;
        height: 100%;
        object-fit: cover; /* Taglio intelligente */
        object-position: center top; /* Preserva l'inquadratura dei volti nei ritratti */
        display: block;
    }

    /* I Metadati e il Testo delle Card */
    .project-meta {
        display: flex;
        flex-direction: column;
        margin-top: auto; /* Allinea perfettamente i blocchi di testo sul fondo */
    }

    .project-meta span {
        font-size: 0.75rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        opacity: 0.45;
    }

    .project-meta h3 {
        margin-top: 0.5rem;
        font-size: 1.3rem;
        font-weight: 500;
        line-height: 1.2;
    }

    /* ==========================================
       CLOSING SECTION
       ========================================== */
    .closing {
        padding: 10rem 2rem;
        text-align: center;
    }

    .closing p {
        max-width: 720px;
        margin: 0 auto;
        font-size: 1.2rem;
        line-height: 1.8;
        opacity: 0.75;
    }

    /* ==========================================
       RESPONSIVE DESIGN
       ========================================== */
    @media (max-width: 900px) {
        .grid {
            grid-template-columns: 1fr;
            gap: 2rem;
        }

        .projects-grid {
            grid-template-columns: 1fr; /* In mobile le card tornano a colonna singola */
        }

        .hero {
            padding-top: 8rem;
        }
    }
</style>
