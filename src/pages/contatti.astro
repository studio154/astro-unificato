---
import LayoutContatti from "@/layouts/LayoutContatti.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContattiResend from "@/components/hubspot-form/ContattiResend.astro";
import Text from "@/components/fundations/elements/Text.astro";

const siteKey = import.meta.env.CLOUDFLARE_TURNSTILE_SITEKEY;
---

<LayoutContatti
  title="Contatta Elio Carchidi – Risposta Rapida per Domande e Collaborazioni"
  description="Hai un progetto, una domanda o vuoi collaborare? Scrivi a Elio Carchidi tramite il modulo di contatto e ricevi una risposta rapida. Inizia la conversazione oggi stesso!"
  image="/2026/05/foto-ritratto-corporate-avvocato-pellegrino-3.jpg"
>
  <!-- Sostituito m-auto con mx-auto e aggiunto text-center per sicurezza nativa -->
  <Wrapper
    variant="standard"
    class="py-12 px-2 sm:px-6 max-w-5xl mx-auto grid gap-8 w-full text-center"
  >
    <header class="text-center grid gap-4 px-2 w-full">
      <Text
        tag="h1"
        variant="textLG"
        class="font-serif uppercase text-base-900"
      >
        <a class="hover:text-base-900 text-gallery-5" href="#"
          >Contatto diretto</a
        >
      </Text>

      <!-- Centratura ferrea orizzontale con mx-auto -->
      <div class="max-w-2xl mx-auto">
        <Text
          tag="p"
          class="!font-serif uppercase text-base-900 leading-relaxed text-center"
        >
          Ogni grande progetto nasce da una conversazione. Scrivimi e descrivimi
          brevemente la tua idea. Ti risponderò personalmente.
        </Text>
      </div>
    </header>

    <!-- Il modulo sfrutta l'ampiezza centrata -->
    <div class="w-full mx-auto text-left">
      <ContattiResend siteKey={siteKey} />
    </div>

    <!-- Sezione contatti alternativi rapidi -->
    <footer class="px-2 w-full mx-auto">
      <Text
        tag="p"
        variant="textBase"
        class="text-center font-serif text-sm uppercase text-base-900 leading-loose"
      >
        Puoi anche inviare una mail o un messaggio <br />
        <a
          href="mailto:info@eliocarchidi.com"
          class="underline decoration-1 underline-offset-4"
        >
          <strong>Email:</strong> info@eliocarchidi.com
        </a>
        <span class="mx-2 block sm:inline-block">-</span>
        <strong>WhatsApp:</strong>
        <a
          href="https://wa.me/393883232460?text=Ciao%20Elio,%20ti%20scrivo%20dal%20sito"
          target="_blank"
          rel="noopener noreferrer"
          class="underline decoration-1 underline-offset-4"
        >
          +39 388 3232460
        </a>
      </Text>
    </footer>
  </Wrapper>

  <!-- Script necessario per caricare Cloudflare Turnstile in modo asincrono -->
  <script
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer></script>
</LayoutContatti>
